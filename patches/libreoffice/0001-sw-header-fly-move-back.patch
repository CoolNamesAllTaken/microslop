diff --git a/sw/source/core/layout/flowfrm.cxx b/sw/source/core/layout/flowfrm.cxx
index 4dd164751..d1fba5153 100644
--- a/sw/source/core/layout/flowfrm.cxx
+++ b/sw/source/core/layout/flowfrm.cxx
@@ -483,8 +483,14 @@ sal_uInt8 SwFlowFrame::BwdMoveNecessary( const SwPageFrame *pPage, const SwRect
                         }
                     }
                 }
-                else
+                else if (!pAnchor->FindFooterOrHeader() || !m_rThis.IsInDocBody()
+                         || m_rThis.GetUpper()->GetFormat()->getIDocumentSettingAccess().get(
+                             DocumentSettingId::USE_FORMER_TEXT_WRAPPING))
                     continue;
+                // else: body text wraps around objects in the page header/footer (see
+                // SwTextFly::GetTop()), so the current formatting depends on them and WouldFit()
+                // is not enough: e.g. a paragraph with 2 lines beside a header image may fit as
+                // 1 line on the previous page.
 
                 nRet |= 2;
             }
