From e69f90b0254781d84251f5fe6fa1d92257e88b2f Mon Sep 17 00:00:00 2001
From: Claud McClaudeson <claud@pantsforbirds.com>
Date: Tue, 6 Oct 2026 05:08:23 +0000
Subject: [PATCH 1/3] sw: move back paragraph that wraps around a header image

A paragraph moved to the next page and formatted there beside a wrapped
image anchored in the page header (2 lines) never moved back to the
previous page, even if it fits there as 1 line.

SwFlowFrame::BwdMoveNecessary() ignored objects anchored in the page
header or footer, since they are in a different context. So
ShouldBwdMoved() used WouldFit() with the current formatting instead of
a test format at the new place, and widow control refused the move.

Body text wraps around header/footer objects (see SwTextFly::GetTop())
unless USE_FORMER_TEXT_WRAPPING is set: report such objects as needing
a test format, too.

Change-Id: Ie3d3a23843cb77c066563dd3ca3603021692dff4
---
 sw/qa/core/layout/calcmove.cxx                |  25 ++++++++++++++++++
 .../layout/data/header-fly-move-back.docx     | Bin 0 -> 3729 bytes
 sw/source/core/layout/flowfrm.cxx             |   8 +++++-
 3 files changed, 32 insertions(+), 1 deletion(-)
 create mode 100644 sw/qa/core/layout/data/header-fly-move-back.docx

diff --git a/sw/qa/core/layout/calcmove.cxx b/sw/qa/core/layout/calcmove.cxx
index 3606c70eb..e203b3264 100644
--- a/sw/qa/core/layout/calcmove.cxx
+++ b/sw/qa/core/layout/calcmove.cxx
@@ -129,6 +129,31 @@ CPPUNIT_TEST_FIXTURE(Test, testHideWhitespaceGrowingLastPage)
     // i.e. the page was growing instead of creating a new page when it already had a max size.
     CPPUNIT_ASSERT_EQUAL(2, getPages());
 }
+
+CPPUNIT_TEST_FIXTURE(Test, testHeaderFlyMoveBack)
+{
+    // Given a document with an image in the page header, and a paragraph at the top of page 2 that
+    // wraps around the image as 2 lines, but would be 1 line at the bottom of page 1:
+    createSwDoc("header-fly-move-back.docx");
+    CPPUNIT_ASSERT_EQUAL(2, getPages());
+
+    // When deleting the last line of the paragraph before it, so there is room for 1 line on page 1:
+    uno::Reference<text::XTextRange> xPara = getParagraph(55);
+    uno::Reference<text::XText> xText = xPara->getText();
+    uno::Reference<text::XTextCursor> xCursor = xText->createTextCursorByRange(xPara->getEnd());
+    // Select the line break and "Delete me".
+    xCursor->goLeft(10, /*bExpand=*/true);
+    xCursor->setString(OUString());
+    calcLayout();
+
+    // Then make sure the paragraph moves back to page 1:
+    // Without the accompanying fix in place, this test would have failed with:
+    // - Expected: 1
+    // - Actual  : 2
+    // i.e. the paragraph stayed on page 2, since its formatting beside the image was used to check
+    // if it fits page 1.
+    CPPUNIT_ASSERT_EQUAL(1, getPages());
+}
 }
 
