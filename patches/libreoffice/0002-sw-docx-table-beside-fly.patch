@@ -257,6 +257,73 @@ CPPUNIT_TEST_FIXTURE(Test, testSplitFlyHeader)
     // Then make sure we get one more page, since the first page is now 2 pages:
     CPPUNIT_ASSERT_EQUAL(9, getPages());
 }
+
+CPPUNIT_TEST_FIXTURE(Test, testTableBesideHeaderFlyWord2007)
+{
+    // Given a DOCX (compatibilityMode 12) with an image in the header and an autofit table that
+    // overlaps it:
+    createSwDoc("table-header-fly-narrow.docx");
+
+    // When laying out that document:
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+
+    // Then make sure the table is narrowed beside the image, like in Word 2007, and only its last
+    // column gets narrower:
+    SwTwips nFlyLeft
+        = getXPath(pXmlDoc, "//page[1]/header/txt/anchored/fly/infos/bounds", "left").toInt32();
+    SwTwips nFlyBottom
+        = getXPath(pXmlDoc, "//page[1]/header/txt/anchored/fly/infos/bounds", "bottom").toInt32();
+    SwTwips nTabTop = getXPath(pXmlDoc, "//page[1]/body/tab/infos/bounds", "top").toInt32()
+                      + getXPath(pXmlDoc, "//page[1]/body/tab/infos/prtBounds", "top").toInt32();
+    SwTwips nTabRight = getXPath(pXmlDoc, "//page[1]/body/tab/infos/bounds", "left").toInt32()
+                        + getXPath(pXmlDoc, "//page[1]/body/tab/infos/prtBounds", "right").toInt32();
+    // Without the accompanying fix in place, this test would have failed, the table was shifted
+    // below the image.
+    CPPUNIT_ASSERT_LESS(nFlyBottom, nTabTop);
+    CPPUNIT_ASSERT_LESS(nFlyLeft, nTabRight);
+    SwTwips nCell1Width
+        = getXPath(pXmlDoc, "//page[1]/body/tab/row[1]/cell[1]/infos/bounds", "width").toInt32();
+    CPPUNIT_ASSERT_EQUAL(static_cast<SwTwips>(600), nCell1Width);
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testFixedTableBesideHeaderFlyWord2007)
+{
+    // Given a DOCX (compatibilityMode 12) with an image in the header and a fixed layout table that
+    // overlaps it:
+    createSwDoc("table-header-fly-fixed.docx");
+
+    // When laying out that document:
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+
+    // Then make sure the table is shifted below the image, like in Word 2007:
+    SwTwips nFlyBottom
+        = getXPath(pXmlDoc, "//page[1]/header/txt/anchored/fly/infos/bounds", "bottom").toInt32();
+    SwTwips nTabTop = getXPath(pXmlDoc, "//page[1]/body/tab/infos/bounds", "top").toInt32()
+                      + getXPath(pXmlDoc, "//page[1]/body/tab/infos/prtBounds", "top").toInt32();
+    CPPUNIT_ASSERT_GREATEREQUAL(nFlyBottom, nTabTop);
+}
+
+CPPUNIT_TEST_FIXTURE(Test, testTableBelowHeaderFlyWord2013)
+{
+    // Given a DOCX (compatibilityMode 15) with a right-aligned image in the header and a table
+    // that overlaps it:
+    createSwDoc("table-header-fly-shift.docx");
+
+    // When laying out that document:
+    xmlDocUniquePtr pXmlDoc = parseLayoutDump();
+
+    // Then make sure the table is shifted below the image and keeps its width, like in Word 2013:
+    SwTwips nFlyBottom
+        = getXPath(pXmlDoc, "//page[1]/header/txt/anchored/fly/infos/bounds", "bottom").toInt32();
+    SwTwips nTabTop = getXPath(pXmlDoc, "//page[1]/body/tab/infos/bounds", "top").toInt32()
+                      + getXPath(pXmlDoc, "//page[1]/body/tab/infos/prtBounds", "top").toInt32();
+    // Without the accompanying fix in place, this test would have failed, the table was narrowed
+    // beside the image: its print area was already narrowed when checking for the overlap.
+    CPPUNIT_ASSERT_GREATEREQUAL(nFlyBottom, nTabTop);
+    SwTwips nTabPrtWidth
+        = getXPath(pXmlDoc, "//page[1]/body/tab/infos/prtBounds", "width").toInt32();
+    CPPUNIT_ASSERT_GREATER(static_cast<SwTwips>(10700), nTabPrtWidth);
+}
 }
 
